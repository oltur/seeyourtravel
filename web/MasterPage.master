    <script src="<%=Tools.V("libs/jquery.cookie.js")%>"></script>
    <script src="<%=Tools.V("libs/jquery.tinycarousel.js")%>"></script>
    <script src="<%=Tools.V("libs/toastr.min.js")%>"></script>
    <script src="<%=Tools.V("libs/leaflet-src.js")%>"></script>
    <script src="<%=Tools.V("libs/leaflet.markercluster-src.js")%>"></script>
