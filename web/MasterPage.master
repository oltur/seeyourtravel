    <link rel="stylesheet" href="<%=Tools.V("styles/leaflet.ie.css")%>"/>
    <![endif]-->
    <link rel="stylesheet" href="<%=Tools.V("styles/jquery-ui.css")%>" />
    <link rel="stylesheet" href="<%=Tools.V("styles/tinycarousel.css")%>" />
    <link rel="stylesheet" href="<%=Tools.V("styles/toastr.min.css")%>" />

    <script>
        var IS_IOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream; 
        var IS_ANDROID = /android/i.test(navigator.userAgent);
        var IS_MOBILE_LIGHTWEIGHT = IS_IOS || IS_ANDROID;
        var IS_ANDROID_WEBVIEW = !!window.JSInterface;
    </script>

    <script src="<%=Tools.V("js/OurTravel.Common.js")%>"></script>
    <script src="<%=Tools.V("js/api.js")%>"></script>
    <script src="<%=Tools.V("js/OurTravel.js")%>"></script>
    <script src="<%=Tools.V("js/AnimatedMarker.js")%>"></script>
    <script src="<%=Tools.V("js/get_text.js")%>"></script>

    <%--<link rel="stylesheet" href="<%=Tools.V("styles/leaflet-routing-machine.css")%>" />--%>

    <link rel="stylesheet" href="<%=Tools.V("styles/ourTravel.common.css")%>" />
    <link rel="stylesheet" href="<%=Tools.V("styles/ourTravel.css")%>" />
    <link rel="stylesheet" href="<%=Tools.V("styles/modern.css")%>" />
    <link rel="stylesheet" href="<%=Tools.V("styles/fonts.css")%>" />

    <meta name="google-signin-client_id" content="179651162952-alrnetid5672ki6fqb7qh8b8ptu9aspk.apps.googleusercontent.com" />

    <script>
        // Analytics (Google Analytics, Clicky) removed; keep a no-op so existing ga(...) calls still work.
        window.ga = function () { };
    </script>

    <script>
        var globalUserId = '<%=Context.User.Identity.Name%>';

        if (IS_ANDROID_WEBVIEW) {
            $.cookie("AndroidWebView", "1");
        }
        else {
            $.cookie("AndroidWebView", "0");
        }

        if (window.JSInterface && window.JSInterface.setUserId)
            window.JSInterface.setUserId(globalUserId);

       
        var globalUserName = '<%=string.IsNullOrWhiteSpace((string)Session["UserName"])?"Guest":Session["UserName"].ToString()%>';
        var globalFacebookLanguage = "en_US";
        var facebookAPIIsLoaded = false;

        ga('set', '&uid', globalUserId); // Set the user ID using signed-in user_id.

        $(function () {
            var sel = $("#langList");
            sel.empty();
            sel.append('<option value="en-US" >En</option>');
            sel.append('<option value="de-DE" >De</option>');
            sel.append('<option value="he" >עברית</option>');
            sel.append('<option value="uk-UA" >Укр</option>');

            var c = $.cookie("i18next");
            if (typeof c != "undefined" && c != null && c != "") {
                sel.val(c);
            }
            globalFacebookLanguage = getFacebookLanguage();

            initFacebook();
        });
    </script>

    <script>
        window.___gcfg = {
            lang: getTwitterLanguage(),
            parsetags: 'onload'
        };
    </script>

    <asp:ContentPlaceHolder ID="HeadPlaceholder" runat="server">
