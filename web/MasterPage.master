    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SeeYourTravel" />
    <meta property="og:title" content="SeeYourTravel.app - replay your journey on the map" />
    <meta property="og:description" content="Create, share and replay your travels on the map, with photos, places and music." />
